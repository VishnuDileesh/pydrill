---
import Base from "../../layouts/Base.astro";
import { challenges, getAdjacent, getModuleChallenges, renderPrompt } from "../../lib/challenges";

export function getStaticPaths() {
  return challenges.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const challenge = challenges.find((c) => c.id === id)!;
const { prev, next } = getAdjacent(id!);
const promptHtml = renderPrompt(challenge.prompt);
const moduleItems = getModuleChallenges(challenge.moduleSlug);
---
<Base title={challenge.title}>
  <Fragment slot="topline-left">
    <a class="back-link" href={`/modules/${challenge.moduleSlug}`}>← {challenge.module}</a>
  </Fragment>

  <div class="challenge-shell">
    <aside class="lesson-rail card">
      <div class="lesson-rail-head">{challenge.module}</div>
      <ol class="rail-list">
        {moduleItems.map((c, i) => (
          <li>
            <a class={`rail-row ${c.id === challenge.id ? "active" : ""}`} href={`/challenge/${c.id}`} data-id={c.id}>
              <span class="row-index" data-idx>{i + 1}</span>
              <span class="row-title">{c.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </aside>

    <div class="player">
      <div class="head-row">
        <h1>{challenge.title}</h1>
        <span class={`badge badge-${challenge.difficulty}`}>{challenge.difficulty}</span>
      </div>
      <p class="prompt" set:html={promptHtml} />

      <div class="panels">
        <div class="panel editor-panel">
          <div class="panel-bar">
            <span class="panel-label">code.py</span>
          </div>
          <textarea id="editor" class="code-editor" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea>
        </div>

        <div class="panel output-panel">
          <div class="panel-bar"><span class="panel-label">Output</span></div>
          <div id="output" class="output-body">
            <p class="text-dim hint">Run your code or run the tests to see results here.</p>
          </div>
        </div>
      </div>

      <p id="status-line" class="status-line" aria-live="polite"></p>
      <p id="success-line" class="success-line" hidden>🎉 All tests passed — marked as solved.</p>

      <div class="control-bar card">
        <div class="control-left">
          <button id="reset-btn" class="icon-btn" title="Reset to starter code" aria-label="Reset to starter code">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
          </button>
          <button id="run-btn" class="btn">▶ Run</button>
          <button id="test-btn" class="btn btn-primary">✓ Run Tests</button>
        </div>
        <div class="control-right">
          {prev
            ? <a class="icon-btn" href={`/challenge/${prev.id}`} title={`Previous: ${prev.title}`} aria-label="Previous challenge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
              </a>
            : <span />}
          <a class="btn" href="/playground">Playground</a>
          {next
            ? <a class="btn btn-primary" href={`/challenge/${next.id}`}>Next →</a>
            : <a class="btn btn-primary" href="/">Done →</a>}
        </div>
      </div>
    </div>
  </div>
</Base>

<script define:vars={{
  id: challenge.id,
  starter: challenge.starter,
  funcName: challenge.funcName,
  tests: challenge.tests,
}}>
  const editor = document.getElementById("editor");
  const runBtn = document.getElementById("run-btn");
  const testBtn = document.getElementById("test-btn");
  const resetBtn = document.getElementById("reset-btn");
  const output = document.getElementById("output");
  const statusLine = document.getElementById("status-line");
  const successLine = document.getElementById("success-line");

  const DRAFT_KEY = "pydrill:draft:" + id;
  const COMPLETED_KEY = "pydrill:completed";

  function loadDraft() {
    try {
      return localStorage.getItem(DRAFT_KEY);
    } catch {
      return null;
    }
  }
  function saveDraft(code) {
    try {
      localStorage.setItem(DRAFT_KEY, code);
    } catch {}
  }
  function markCompleted() {
    try {
      const raw = localStorage.getItem(COMPLETED_KEY);
      const set = new Set(raw ? JSON.parse(raw) : []);
      set.add(id);
      localStorage.setItem(COMPLETED_KEY, JSON.stringify([...set]));
    } catch {}
  }

  editor.value = loadDraft() ?? starter;
  editor.addEventListener("input", () => saveDraft(editor.value));

  editor.addEventListener("keydown", (e) => {
    if (e.key === "Tab") {
      e.preventDefault();
      const start = editor.selectionStart;
      const end = editor.selectionEnd;
      editor.value = editor.value.slice(0, start) + "    " + editor.value.slice(end);
      editor.selectionStart = editor.selectionEnd = start + 4;
    }
  });

  resetBtn.addEventListener("click", () => {
    if (confirm("Reset your code back to the starter template?")) {
      editor.value = starter;
      saveDraft(starter);
      output.innerHTML = '<p class="text-dim hint">Run your code or run the tests to see results here.</p>';
      successLine.hidden = true;
    }
  });

  function setButtonsDisabled(disabled) {
    runBtn.disabled = disabled;
    testBtn.disabled = disabled;
  }

  let pyodidePromise = null;
  async function getPyodide() {
    if (!pyodidePromise) {
      statusLine.textContent = "Booting Python runtime (first run only)…";
      pyodidePromise = (async () => {
        if (!window.loadPyodide) {
          await new Promise((resolve, reject) => {
            const s = document.createElement("script");
            s.src = "https://cdn.jsdelivr.net/pyodide/v0.26.4/full/pyodide.js";
            s.onload = resolve;
            s.onerror = reject;
            document.head.appendChild(s);
          });
        }
        return await window.loadPyodide({ indexURL: "https://cdn.jsdelivr.net/pyodide/v0.26.4/full/" });
      })();
    }
    const p = await pyodidePromise;
    statusLine.textContent = "";
    return p;
  }

  function escapeHtml(s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function fmtValue(v) {
    return JSON.stringify(v);
  }

  const RUN_HARNESS = `
import sys, io, json
buf = io.StringIO()
old_stdout = sys.stdout
sys.stdout = buf
result = {}
try:
    exec(user_code, {})
    result["stdout"] = buf.getvalue()
except Exception as e:
    result["stdout"] = buf.getvalue()
    result["error"] = f"{type(e).__name__}: {e}"
finally:
    sys.stdout = old_stdout
json.dumps(result)
`;

  const TEST_HARNESS = `
import json, sys, io
results = {}
ns = {}
buf = io.StringIO()
old_stdout = sys.stdout
sys.stdout = buf
try:
    exec(user_code, ns)
    sys.stdout = old_stdout
except Exception as e:
    sys.stdout = old_stdout
    results = {"error": f"{type(e).__name__}: {e}", "stdout": buf.getvalue()}
else:
    tests = json.loads(tests_json)
    func = ns.get(func_name)
    if func is None:
        results = {"error": f"Function '{func_name}' not found. Did you rename it or forget to define it?", "stdout": buf.getvalue()}
    else:
        test_results = []
        for t in tests:
            entry = {"args": t["args"], "expected": t["expected"]}
            tb = io.StringIO()
            sys.stdout = tb
            try:
                actual = func(*t["args"])
                entry["actual"] = actual
                entry["passed"] = actual == t["expected"]
            except Exception as e:
                entry["error"] = f"{type(e).__name__}: {e}"
                entry["passed"] = False
            sys.stdout = old_stdout
            entry["stdout"] = tb.getvalue()
            test_results.append(entry)
        results = {"tests": test_results, "stdout": buf.getvalue()}
json.dumps(results)
`;

  runBtn.addEventListener("click", async () => {
    setButtonsDisabled(true);
    successLine.hidden = true;
    output.innerHTML = '<p class="text-dim hint">Running…</p>';
    try {
      const pyodide = await getPyodide();
      pyodide.globals.set("user_code", editor.value);
      const raw = await pyodide.runPythonAsync(RUN_HARNESS);
      const res = JSON.parse(raw);
      let html = "";
      if (res.stdout) html += `<pre class="stdout">${escapeHtml(res.stdout)}</pre>`;
      if (res.error) html += `<p class="err-line">${escapeHtml(res.error)}</p>`;
      if (!res.stdout && !res.error) html = '<p class="text-dim hint">Ran with no output. Try adding a print(...) to check values.</p>';
      output.innerHTML = html;
    } catch (e) {
      output.innerHTML = `<p class="err-line">${escapeHtml(e)}</p>`;
    } finally {
      setButtonsDisabled(false);
    }
  });

  testBtn.addEventListener("click", async () => {
    setButtonsDisabled(true);
    successLine.hidden = true;
    output.innerHTML = '<p class="text-dim hint">Running tests…</p>';
    try {
      const pyodide = await getPyodide();
      pyodide.globals.set("user_code", editor.value);
      pyodide.globals.set("func_name", funcName);
      pyodide.globals.set("tests_json", JSON.stringify(tests));
      const raw = await pyodide.runPythonAsync(TEST_HARNESS);
      const res = JSON.parse(raw);

      if (res.error) {
        output.innerHTML = `<p class="err-line">${escapeHtml(res.error)}</p>` +
          (res.stdout ? `<pre class="stdout">${escapeHtml(res.stdout)}</pre>` : "");
        return;
      }

      const rows = res.tests.map((t) => {
        const argsStr = t.args.map(fmtValue).join(", ");
        if (t.passed) {
          return `<li class="test-row pass"><span class="tmark">✓</span><code>${funcName}(${escapeHtml(argsStr)})</code> → <code>${escapeHtml(fmtValue(t.actual))}</code></li>`;
        }
        const detail = t.error
          ? `raised <code>${escapeHtml(t.error)}</code>`
          : `got <code>${escapeHtml(fmtValue(t.actual))}</code>, expected <code>${escapeHtml(fmtValue(t.expected))}</code>`;
        return `<li class="test-row fail"><span class="tmark">✗</span><code>${funcName}(${escapeHtml(argsStr)})</code> — ${detail}</li>`;
      }).join("");

      const passCount = res.tests.filter((t) => t.passed).length;
      const allPass = passCount === res.tests.length;

      output.innerHTML = `<p class="test-summary">${passCount} / ${res.tests.length} tests passed</p><ul class="test-list">${rows}</ul>`;

      if (allPass) {
        markCompleted();
        successLine.hidden = false;
        const railRow = document.querySelector(`.rail-row[data-id="${id}"]`);
        if (railRow) {
          railRow.classList.add("done");
          const idx = railRow.querySelector("[data-idx]");
          if (idx) idx.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><path d="M20 6 9 17l-5-5"/></svg>';
        }
      }
    } catch (e) {
      output.innerHTML = `<p class="err-line">${escapeHtml(e)}</p>`;
    } finally {
      setButtonsDisabled(false);
    }
  });

  (function paintCompletedInRail() {
    try {
      const raw = localStorage.getItem(COMPLETED_KEY);
      const completed = new Set(raw ? JSON.parse(raw) : []);
      document.querySelectorAll(".rail-row[data-id]").forEach((el) => {
        const rid = el.getAttribute("data-id");
        if (rid && completed.has(rid)) {
          el.classList.add("done");
          const idx = el.querySelector("[data-idx]");
          if (idx) idx.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><path d="M20 6 9 17l-5-5"/></svg>';
        }
      });
    } catch {}
  })();
</script>

<style>
  .back-link { color: var(--text-dim); text-decoration: none; font-size: 0.9rem; font-weight: 600; }

  .challenge-shell { display: flex; flex-direction: column; gap: 16px; }

  .lesson-rail { display: none; }
  .lesson-rail-head { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-dim); padding: 6px 10px 10px; }
  .rail-list { list-style: none; margin: 0; padding: 0; max-height: 60vh; overflow-y: auto; }
  .rail-row {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
    padding: 9px 10px;
    border-radius: var(--radius-sm);
    font-size: 0.86rem;
  }
  .rail-row:hover { background: var(--surface-2); }
  .rail-row.active { background: var(--surface-2); font-weight: 700; }
  .rail-row .row-index {
    width: 22px; height: 22px; flex-shrink: 0; border-radius: 999px;
    background: var(--code-bg); color: var(--text-dim);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.7rem; font-weight: 700;
  }
  .rail-row.done .row-index { background: var(--ok-bg); color: var(--ok); }
  .rail-row .row-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .head-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 4px 0 6px; }
  .head-row h1 { margin: 0; font-size: 1.35rem; }
  .prompt { color: var(--text); font-size: 0.98rem; max-width: 68ch; margin: 0 0 18px; }

  .panels { display: flex; flex-direction: column; gap: 14px; }
  .panel {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }
  .panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .panel-label { font-size: 0.78rem; color: var(--text-dim); font-weight: 600; }

  .code-editor {
    width: 100%;
    min-height: 220px;
    border: none;
    resize: vertical;
    padding: 14px;
    font-size: 16px;
    line-height: 1.5;
    background: var(--surface);
    color: var(--text);
    tab-size: 4;
  }
  .code-editor:focus { outline: none; }

  .status-line { margin: 10px 2px 0; font-size: 0.82rem; color: var(--text-dim); min-height: 1em; }
  .success-line {
    margin: 10px 0 0;
    font-weight: 700;
    color: var(--ok);
    background: var(--ok-bg);
    padding: 10px 14px;
    border-radius: var(--radius-md);
  }

  .output-body { padding: 14px; min-height: 80px; }
  .output-body .hint { margin: 0; }
  .stdout {
    white-space: pre-wrap;
    word-break: break-word;
    background: var(--code-bg);
    padding: 10px;
    border-radius: 8px;
    margin: 0 0 10px;
    font-size: 0.88rem;
  }
  .err-line {
    color: var(--fail);
    background: var(--fail-bg);
    padding: 10px;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    margin: 0;
  }
  .test-summary { margin: 0 0 10px; font-weight: 600; }
  .test-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .test-row {
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-size: 0.86rem;
    padding: 8px 10px;
    border-radius: 8px;
  }
  .test-row.pass { background: var(--ok-bg); }
  .test-row.fail { background: var(--fail-bg); }
  .test-row .tmark { flex-shrink: 0; font-weight: 700; }
  .test-row.pass .tmark { color: var(--ok); }
  .test-row.fail .tmark { color: var(--fail); }
  .test-row code { word-break: break-word; }

  .control-bar {
    margin-top: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    padding: 10px;
    position: sticky;
    bottom: 76px;
  }
  .control-left, .control-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }
  .icon-btn svg { width: 18px; height: 18px; }
  .icon-btn:hover { background: var(--surface-2); }

  @media (min-width: 900px) {
    .challenge-shell { flex-direction: row; align-items: flex-start; }
    .lesson-rail { display: block; flex: 0 0 260px; position: sticky; top: 76px; padding: 10px; }
    .player { flex: 1; min-width: 0; }
    .control-bar { position: sticky; bottom: 16px; }
    .panels { flex-direction: row; align-items: stretch; }
    .panel { flex: 1; display: flex; flex-direction: column; }
    .editor-panel { flex: 1.1; }
    .code-editor { flex: 1; }
    .output-body { flex: 1; overflow-y: auto; max-height: 420px; }
  }
</style>
